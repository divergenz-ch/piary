node_modules/
dist/
# The e2e harness's esbuild output (`pnpm build:harness`): generated on every
# run, never source. Bundles once rode along in the history, ~8MB of them stale.
demo/*-app.js
demo/*-app.css
# The a2ui processor bundled for the packaged extension (`pnpm bundle:extension`,
# part of `pnpm build`): generated, shipped in Resources/pi-extension/, never source.
pi-extension/a2ui-core.bundle.js
# The developer's private conversation corpus, at the repo root. Read by
# tests/unit/document-replay.test.ts when present, never required.
/pi-docs/
recovery/
.DS_Store
.pi/npm/
debug_img/
# Local working files: never part of the project.
/recordings/
# A release being prepared: its plan and its notes (`make pre-release`).
/release/
.flow/
/docs/plans/
/.claude/
/AGENTS.md
/CLAUDE.md

# JetBrains project settings: per-developer, and partly machine-specific.
.idea/

# Playwright's own run output: the per-failure artifacts (traces, screenshots,
# error context) and the HTML report CI uploads. Both are regenerated by every
# `pnpm test:e2e`. The harness bundle's entry is covered by `demo/*-app.js` and
# `demo/*-app.css` above; its split chunks (the cell engine, loaded with the
# first cell) land beside it.
demo/harness-chunks/
test-results/
# WDIO's JUnit output for the real-app layer.
test-results/app/
playwright-report/
blob-report/

# Cargo's build tree: gigabytes of compiled dependencies, regenerated by
# `cargo build`.
target/
# tauri-build regenerates these from the capabilities files on every build, and
# names the host platform in them.
src-tauri/gen/
# Vite's output for the app page, the input `tauri build` bundles.
app/dist/
# The compiled capture helper. Its source is tracked; rebuild with
# `pnpm sidecar:build`, which names the target triple Tauri's externalBin
# expects.
sidecar/bin/
# What the face detector loads: MediaPipe's wasm and model, put here by
# `pnpm face:assets` (ADR 0058).
app/public/face/
