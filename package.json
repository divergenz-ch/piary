{
	"name": "piary",
	"version": "0.0.1",
	"description": "One canvas, not a chat: a markdown document the user and the pi agent both write into",
	"type": "module",
	"engines": {
		"node": ">=22.18"
	},
	"files": [
		"dist",
		"src",
		"README.md"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json && esbuild src/styles/styles.css --bundle --minify --loader:.woff2=file --loader:.woff=file --loader:.ttf=file --loader:.otf=file --outfile=dist/styles.css && pnpm bundle:extension",
		"bundle:extension": "esbuild scripts/a2ui-core-entry.ts --bundle --format=esm --platform=node --minify --log-level=warning --outfile=pi-extension/a2ui-core.bundle.js",
		"typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.app-e2e.json",
		"watch": "tsc -p tsconfig.build.json --watch",
		"lint": "node scripts/verify-hygiene.ts",
		"eval": "node evals/run.ts",
		"test": "node scripts/node-tests.ts",
		"test:unit": "node --test 'tests/unit/*.test.ts'",
		"test:contract": "node --test 'tests/contract/*.test.ts'",
		"test:integration": "node --test 'tests/integration/*.test.ts'",
		"test:smoke": "(cd src-tauri && cargo fmt --check) && pnpm build && node scripts/node-tests.ts unit contract && pnpm rust:test && playwright test -c playwright.app.config.ts --grep @smoke",
		"test:all": "pnpm verify && pnpm test:e2e && pnpm verify:rust",
		"build:harness": "pnpm build && pnpm bundle:harness",
		"bundle:harness": "esbuild demo/harness.ts --bundle --format=esm --splitting --outdir=demo --entry-names=[name]-app --chunk-names=harness-chunks/[name]-[hash]",
		"test:e2e": "playwright test && playwright test -c playwright.app.config.ts",
		"verify": "pnpm typecheck && pnpm lint && pnpm build && pnpm test",
		"app": "tauri dev",
		"app:dev": "vite --config app/vite.config.ts",
		"app:build": "pnpm build && pnpm face:assets && pnpm app:page",
		"face:assets": "node scripts/face-assets.ts",
		"app:page": "vite build --config app/vite.config.ts",
		"app:bundle": "tauri build",
		"app:release": "node scripts/release-build.ts",
		"tauri": "tauri",
		"verify:rust": "pnpm rust:check && pnpm rust:bindings",
		"rust:test": "node scripts/rust-test.ts",
		"rust:check": "cd src-tauri && cargo fmt --check && cargo clippy --all-targets -- -D warnings && cargo test",
		"rust:bindings": "git diff --exit-code --quiet src/bridge-types.ts || { echo 'src/bridge-types.ts is stale — commit the file cargo test regenerated'; exit 1; }",
		"sidecar:build": "node scripts/sidecar-build.ts",
		"app:e2e:build": "pnpm sidecar:build && pnpm app:build && cd src-tauri && cargo build --features e2e,tauri/custom-protocol",
		"test:app": "wdio run wdio.conf.ts",
		"app:dmg": "tauri build --bundles dmg"
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": "*",
		"@earendil-works/pi-ai": "*",
		"lit": "^3.3.1"
	},
	"dependencies": {
		"@a2ui/lit": "0.15.0",
		"@a2ui/web_core": "0.15.0",
		"@codemirror/autocomplete": "^6.20.3",
		"@codemirror/commands": "^6.10.4",
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/lang-markdown": "^6.5.2",
		"@codemirror/language": "^6.12.4",
		"@codemirror/state": "^6.7.1",
		"@codemirror/view": "^6.43.8",
		"@earendil-works/pi-coding-agent": "1.1.0",
		"@lezer/highlight": "^1.2.3",
		"@mediapipe/tasks-vision": "1.2.3",
		"@observablehq/notebook-kit": "2.3.0",
		"@observablehq/plot": "0.6.19",
		"@tauri-apps/api": "^2.12.3",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/xterm": "^6.0.0",
		"katex": "^0.16.22",
		"lucide": "^0.544.0",
		"marked": "^16.3.0",
		"zod": "3.25.76"
	},
	"devDependencies": {
		"@earendil-works/pi-agent-core": "^1.1.0",
		"@earendil-works/pi-ai": "^1.1.0",
		"@playwright/test": "^1.63.0",
		"@tauri-apps/cli": "^2.12.2",
		"@types/jsdom": "^30.0.0",
		"@types/katex": "^0.16.7",
		"@types/mocha": "^10.0.10",
		"@types/node": "^24.19.1",
		"@wdio/cli": "^9.33.1",
		"@wdio/globals": "^9.33.1",
		"@wdio/junit-reporter": "^9.33.1",
		"@wdio/local-runner": "^9.33.1",
		"@wdio/mocha-framework": "^9.33.1",
		"@wdio/spec-reporter": "^9.33.1",
		"@wdio/tauri-service": "^1.5.1",
		"esbuild": "^0.28.1",
		"expect-webdriverio": "^6.1.0",
		"jsdom": "^30.0.1",
		"lit": "^3.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.4",
		"webdriverio": "^9.33.1"
	},
	"packageManager": "pnpm@11.9.0",
	"license": "PolyForm-Noncommercial-1.0.0"
}
